---
// Spatial data visualization for hero section
---

<div class="spatial-viz">
  <canvas id="spatial-canvas"></canvas>
</div>

<style>
  .spatial-viz {
    width: 100%;
    height: 100%;
    min-height: 500px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 50% 50%, rgba(59, 130, 246, 0.02) 0%, rgba(9, 9, 11, 0.98) 100%);
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.5);
  }
  
  #spatial-canvas {
    width: 100%;
    height: 100%;
  }
  
  @media (max-width: 768px) {
    .spatial-viz {
      min-height: 350px;
    }
  }
</style>

<script>
  const canvas = document.getElementById('spatial-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('Could not get canvas context');
  
  // Check for reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  let width = canvas.offsetWidth;
  let height = canvas.offsetHeight;
  canvas.width = width * window.devicePixelRatio;
  canvas.height = height * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  
  // Point cloud configuration - structured room corner
  interface Point {
    x: number;
    y: number;
    z: number;
    size: number;
    baseOpacity: number;
    type: 'wall' | 'floor' | 'ceiling' | 'object';
  }
  
  const points: Point[] = [];
  const maxDepth = 300;
  
  // Create a room corner structure (back wall, left wall, floor)
  const roomDepth = 200;
  const roomWidth = 300;
  const roomHeight = 250;
  
  // Back wall - dense grid
  for (let x = -roomWidth/2; x < roomWidth/2; x += 12) {
    for (let y = -roomHeight/2; y < roomHeight/2; y += 12) {
      points.push({
        x: x + (Math.random() - 0.5) * 4,
        y: y + (Math.random() - 0.5) * 4,
        z: -roomDepth/2 + (Math.random() - 0.5) * 8,
        size: 1.5 + Math.random() * 0.5,
        baseOpacity: 0.4 + Math.random() * 0.3,
        type: 'wall'
      });
    }
  }
  
  // Left wall - dense grid
  for (let z = -roomDepth/2; z < roomDepth/2; z += 12) {
    for (let y = -roomHeight/2; y < roomHeight/2; y += 12) {
      points.push({
        x: -roomWidth/2 + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 4,
        z: z + (Math.random() - 0.5) * 4,
        size: 1.5 + Math.random() * 0.5,
        baseOpacity: 0.35 + Math.random() * 0.25,
        type: 'wall'
      });
    }
  }
  
  // Floor - dense grid
  for (let x = -roomWidth/2; x < roomWidth/2; x += 12) {
    for (let z = -roomDepth/2; z < roomDepth/2; z += 12) {
      points.push({
        x: x + (Math.random() - 0.5) * 4,
        y: roomHeight/2 + (Math.random() - 0.5) * 8,
        z: z + (Math.random() - 0.5) * 4,
        size: 1.5 + Math.random() * 0.5,
        baseOpacity: 0.3 + Math.random() * 0.2,
        type: 'floor'
      });
    }
  }
  
  // Add a box/object in the room for recognizable structure
  const boxSize = 50;
  const boxX = 30;
  const boxY = 40;
  const boxZ = -30;
  
  for (let x = -boxSize/2; x < boxSize/2; x += 8) {
    for (let y = -boxSize/2; y < boxSize/2; y += 8) {
      // Front face
      points.push({
        x: boxX + x + (Math.random() - 0.5) * 3,
        y: boxY + y + (Math.random() - 0.5) * 3,
        z: boxZ + boxSize/2 + (Math.random() - 0.5) * 3,
        size: 1.8 + Math.random() * 0.4,
        baseOpacity: 0.6 + Math.random() * 0.3,
        type: 'object'
      });
      // Top face
      points.push({
        x: boxX + x + (Math.random() - 0.5) * 3,
        y: boxY - boxSize/2 + (Math.random() - 0.5) * 3,
        z: boxZ + y + (Math.random() - 0.5) * 3,
        size: 1.8 + Math.random() * 0.4,
        baseOpacity: 0.5 + Math.random() * 0.3,
        type: 'object'
      });
    }
  }
  
  let rotation = { x: 0.15, y: 0.2 };
  let targetRotation = { x: 0.15, y: 0.2 };
  
  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    targetRotation.x = ((e.clientY - rect.top) / height - 0.5) * 0.4;
    targetRotation.y = ((e.clientX - rect.left) / width - 0.5) * 0.4 + 0.2;
  });
  
  function rotatePoint(x: number, y: number, z: number): { x: number; y: number; z: number } {
    // Rotate around Y axis
    let x1 = x * Math.cos(rotation.y) - z * Math.sin(rotation.y);
    let z1 = x * Math.sin(rotation.y) + z * Math.cos(rotation.y);
    
    // Rotate around X axis
    let y1 = y * Math.cos(rotation.x) - z1 * Math.sin(rotation.x);
    let z2 = y * Math.sin(rotation.x) + z1 * Math.cos(rotation.x);
    
    return { x: x1, y: y1, z: z2 };
  }
  
  function project(point: { x: number; y: number; z: number }): { x: number; y: number; scale: number } {
    const fov = 400;
    const scale = fov / (fov + point.z + 150);
    return {
      x: point.x * scale + width / 2,
      y: point.y * scale + height / 2,
      scale
    };
  }
  
  function update() {
    if (!prefersReducedMotion) {
      // Smooth rotation following mouse
      rotation.x += (targetRotation.x - rotation.x) * 0.05;
      rotation.y += (targetRotation.y - rotation.y) * 0.05;
    }
  }
  
  function draw() {
    // Clear with fade for motion blur effect
    ctx.fillStyle = 'rgba(9, 9, 11, 0.15)';
    ctx.fillRect(0, 0, width, height);
    
    // Transform and sort points by depth
    const transformedPoints = points.map(point => {
      const rotated = rotatePoint(point.x, point.y, point.z);
      const proj = project(rotated);
      return { ...point, rotated, proj };
    }).sort((a, b) => a.rotated.z - b.rotated.z);
    
    // Draw bounding box wireframe
    ctx.strokeStyle = 'rgba(59, 130, 246, 0.15)';
    ctx.lineWidth = 1;
    ctx.globalAlpha = 0.3;
    
    const boxCorners = [
      [-roomWidth/2, -roomHeight/2, -roomDepth/2],
      [roomWidth/2, -roomHeight/2, -roomDepth/2],
      [roomWidth/2, roomHeight/2, -roomDepth/2],
      [-roomWidth/2, roomHeight/2, -roomDepth/2],
      [-roomWidth/2, -roomHeight/2, roomDepth/2],
      [roomWidth/2, -roomHeight/2, roomDepth/2],
      [roomWidth/2, roomHeight/2, roomDepth/2],
      [-roomWidth/2, roomHeight/2, roomDepth/2],
    ];
    
    const boxEdges = [
      [0,1], [1,2], [2,3], [3,0], // back face
      [4,5], [5,6], [6,7], [7,4], // front face
      [0,4], [1,5], [2,6], [3,7]  // connecting edges
    ];
    
    boxEdges.forEach(([i, j]) => {
      const p1 = project(rotatePoint(boxCorners[i][0], boxCorners[i][1], boxCorners[i][2]));
      const p2 = project(rotatePoint(boxCorners[j][0], boxCorners[j][1], boxCorners[j][2]));
      ctx.beginPath();
      ctx.moveTo(p1.x, p1.y);
      ctx.lineTo(p2.x, p2.y);
      ctx.stroke();
    });
    
    // Draw scan lines
    ctx.globalAlpha = 0.08;
    for (let i = 0; i < 5; i++) {
      const y = (i / 5) * height;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }
    
    // Draw points with depth-based coloring
    transformedPoints.forEach(point => {
      const { proj, rotated, baseOpacity, size, type } = point;
      
      // Depth-based opacity and color intensity
      const depthFactor = 1 - (rotated.z + maxDepth) / (maxDepth * 2);
      const opacity = baseOpacity * proj.scale * Math.max(0.3, depthFactor);
      
      // Color based on type and depth
      let r = 59, g = 130, b = 246;
      if (type === 'object') {
        r = 96; g = 165; b = 250; // Brighter blue for objects
      } else if (type === 'floor') {
        r = 45; g = 100; b = 200; // Slightly darker
      }
      
      const pointSize = size * proj.scale * 1.2;
      
      ctx.globalAlpha = opacity;
      ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
      ctx.beginPath();
      ctx.arc(proj.x, proj.y, pointSize, 0, Math.PI * 2);
      ctx.fill();
      
      // Glow for closer/object points
      if (proj.scale > 0.7 || type === 'object') {
        ctx.globalAlpha = opacity * 0.2;
        ctx.beginPath();
        ctx.arc(proj.x, proj.y, pointSize * 2.5, 0, Math.PI * 2);
        ctx.fill();
      }
    });
    
    ctx.globalAlpha = 1;
  }
  
  function animate() {
    update();
    draw();
    requestAnimationFrame(animate);
  }
  
  // Handle resize
  const resizeObserver = new ResizeObserver(() => {
    width = canvas.offsetWidth;
    height = canvas.offsetHeight;
    canvas.width = width * window.devicePixelRatio;
    canvas.height = height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  });
  
  resizeObserver.observe(canvas);
  
  // Start animation
  animate();
</script>
