---
// Footer component
const isHome = Astro.url.pathname === '/';
---

<footer id="footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="footer-title">Sky3 Network</div>
        <p class="footer-tagline">An open protocol for verifying spatial AI. Stewarded by a non-profit foundation (in formation).</p>
      </div>
      
      <div class="footer-links">
        <nav class="footer-nav">
          <div class="nav-label">Protocol</div>
          <a href={isHome ? '#manifesto' : '/#manifesto'}>Manifesto</a>
          <a href={isHome ? '#leaderboard' : '/#leaderboard'}>Leaderboard</a>
          <a href="/roadmap">Roadmap</a>
          <a href={isHome ? '#waitlist' : '/#waitlist'}>Join the waitlist</a>
        </nav>
        
        <nav class="footer-nav">
          <div class="nav-label">Learn</div>
          <a href="/what-is-spatial-ai">What is Spatial AI?</a>
          <a href="/world-models">World Models</a>
          <a href="/metrics">Metrics</a>
          <a href="/benchmarks">Benchmarks</a>
          <a href="/glossary">Glossary</a>
          <a href="/faq">FAQ</a>
        </nav>
        
        <nav class="footer-nav">
          <div class="nav-label">Legal</div>
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="footer-copyright">© 2026 Sky3 Network. Leaderboard figures on this page are sample data. Company and model names used as examples do not imply affiliation.</p>
    </div>
  </div>
</footer>

<style>
  #footer {
    background: var(--bg-primary);
    border-top: 1px solid var(--border);
    padding: 80px 0 48px;
  }
  
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .footer-main {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 80px;
    margin-bottom: 56px;
  }
  
  .footer-brand {
    max-width: 400px;
  }
  
  .footer-title {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  
  .footer-tagline {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    font-weight: 400;
  }
  
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  
  .nav-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: 6px;
    font-weight: 600;
  }
  
  .footer-nav a {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    transition: var(--transition);
    font-weight: 500;
  }
  
  .footer-nav a:hover {
    color: var(--text-primary);
  }
  
  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  
  .footer-copyright {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }
  
  @media (max-width: 768px) {
    #footer {
      padding: 60px 0 40px;
    }
    
    .footer-container {
      padding: 0 20px;
    }
    
    .footer-main {
      grid-template-columns: 1fr;
      gap: 48px;
      margin-bottom: 40px;
    }
    
    .footer-links {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    
    .footer-nav {
      gap: 12px;
    }
  }
</style>
