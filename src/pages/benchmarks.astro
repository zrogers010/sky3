        "description": "Large-scale repository of 3D CAD models organized by category."
      }
    },
    {
      "@type": "ListItem",
      "position": 6,
      "item": {
        "@type": "Dataset",
        "name": "ARKitScenes",
        "url": "https://github.com/apple/ARKitScenes",
        "description": "High-resolution depth scans of indoor environments captured with LiDAR on mobile devices."
      }
    },
    {
      "@type": "ListItem",
      "position": 7,
      "item": {
        "@type": "Dataset",
        "name": "Matterport3D",
        "url": "https://niessner.github.io/Matterport/",
        "description": "Large-scale RGB-D dataset of building-scale indoor spaces with semantic annotations."
      }
    },
    {
      "@type": "ListItem",
      "position": 8,
      "item": {
        "@type": "Dataset",
        "name": "Replica",
        "url": "https://github.com/facebookresearch/Replica-Dataset",
        "description": "High-quality 3D reconstructions of indoor spaces for visual SLAM and embodied AI."
      }
    },
    {
      "@type": "ListItem",
      "position": 9,
      "item": {
        "@type": "Dataset",
        "name": "Open X-Embodiment",
        "url": "https://robotics-transformer-x.github.io/",
        "description": "Large-scale dataset of robotic manipulation demonstrations across multiple platforms."
      }
    },
    {
      "@type": "ListItem",
      "position": 10,
      "item": {
        "@type": "Dataset",
