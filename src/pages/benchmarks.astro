        "url": "https://objaverse.allenai.org/",
        "description": "Massive dataset of 800K+ annotated 3D objects for 3D vision models."
      }
    },
    {
      "@type": "ListItem",
      "position": 11,
      "item": {
        "@type": "Dataset",
        "name": "SUN RGB-D",
