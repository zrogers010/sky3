<style>
  .page-header {
    margin: 80px 0 48px 0;
  }

  .page-intro {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-top: 24px;
    max-width: 72ch;
  }

  section {
    margin: 64px 0;
  }

  section h2 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 32px;
    color: var(--text-primary);
  }

  .benchmark-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .benchmark-item {
    border-left: 3px solid var(--border);
    padding-left: 24px;
  }

  .benchmark-item dt {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .benchmark-item dt a {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .benchmark-item dt a:hover {
    border-bottom-color: var(--accent);
  }

  .benchmark-item dd {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 6px 0;
  }

  .benchmark-item dd.meta {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-top: 8px;
  }

  .benchmark-item dd.meta a {
    color: var(--text-tertiary);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }

  .benchmark-item dd.meta a:hover {
    border-bottom-color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .page-header {
      margin: 40px 0 32px 0;
    }

    section {
      margin: 48px 0;
    }

    section h2 {
      font-size: 1.5rem;
      margin-bottom: 24px;
    }

    .benchmark-item {
      padding-left: 16px;
    }

    .benchmark-item dt {
      font-size: 1.125rem;
    }
  }
</style>
