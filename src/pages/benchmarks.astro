---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BetaCTA from '../components/BetaCTA.astro';

const title = 'Public Spatial AI Benchmarks | Sky3 Network';
const description = 'Major public benchmarks and datasets for 3D vision, spatial AI, autonomous driving, indoor scene understanding, and robotics: ScanNet, KITTI, nuScenes, Waymo, ShapeNet, ARKitScenes, Matterport3D, Replica, SUN RGB-D, Objaverse, and Open X-Embodiment.';
---

<BaseLayout title={title} description={description}>
  <Header />
  
  <main>
    <article class="container">
      <header class="page-header">
        <h1>Public Spatial AI Benchmarks</h1>
        <p class="page-intro">Major public benchmarks and datasets for evaluating 3D vision, spatial understanding, and physical-world AI. These resources have driven advances in scene reconstruction, object detection, and robotics. Sky3 complements them by providing a community-governed benchmark focused on real-world edge cases contributed and verified by independent participants.</p>
      </header>

      <section id="indoor-scenes">
        <h2>Indoor Scene Understanding</h2>
        
        <dl class="benchmark-list">
          <div class="benchmark-item">
            <dt><a href="http://www.scan-net.org/" rel="nofollow noopener" target="_blank">ScanNet</a></dt>
            <dd>RGB-D video dataset of indoor scenes with 3D camera poses, surface reconstructions, and semantic segmentations.</dd>
            <dd class="meta">Princeton, TUM | <a href="https://arxiv.org/abs/1702.04405" rel="nofollow noopener" target="_blank">Paper (CVPR 2017)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://github.com/apple/ARKitScenes" rel="nofollow noopener" target="_blank">ARKitScenes</a></dt>
            <dd>High-resolution depth scans of indoor environments captured with LiDAR on mobile devices.</dd>
            <dd class="meta">Apple | <a href="https://arxiv.org/abs/2111.08897" rel="nofollow noopener" target="_blank">Paper (NeurIPS 2021)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://niessner.github.io/Matterport/" rel="nofollow noopener" target="_blank">Matterport3D</a></dt>
            <dd>Large-scale RGB-D dataset of building-scale indoor spaces with semantic annotations.</dd>
            <dd class="meta">Princeton, Stanford, TUM | <a href="https://arxiv.org/abs/1709.06158" rel="nofollow noopener" target="_blank">Paper (3DV 2017)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://github.com/facebookresearch/Replica-Dataset" rel="nofollow noopener" target="_blank">Replica</a></dt>
            <dd>High-quality 3D reconstructions of indoor spaces designed for evaluating visual SLAM and embodied AI.</dd>
            <dd class="meta">Meta Reality Labs | <a href="https://arxiv.org/abs/1906.05797" rel="nofollow noopener" target="_blank">Paper (ICCV 2019)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://rgbd.cs.princeton.edu/" rel="nofollow noopener" target="_blank">SUN RGB-D</a></dt>
            <dd>Large-scale RGB-D scene understanding benchmark with 10,000 images and dense annotations.</dd>
            <dd class="meta">Princeton | <a href="https://rgbd.cs.princeton.edu/paper.pdf" rel="nofollow noopener" target="_blank">Paper (CVPR 2015)</a></dd>
          </div>
        </dl>
      </section>

      <section id="autonomous-driving">
        <h2>Autonomous Driving and Outdoor Scenes</h2>
        
        <dl class="benchmark-list">
          <div class="benchmark-item">
            <dt><a href="https://www.cvlibs.net/datasets/kitti/" rel="nofollow noopener" target="_blank">KITTI Vision Benchmark Suite</a></dt>
            <dd>Autonomous driving dataset with stereo video, LiDAR point clouds, GPS/IMU data, and 3D object annotations.</dd>
            <dd class="meta">Karlsruhe Institute of Technology, Toyota | <a href="http://www.cvlibs.net/publications/Geiger2013IJRR.pdf" rel="nofollow noopener" target="_blank">Paper (IJRR 2013)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://www.nuscenes.org/" rel="nofollow noopener" target="_blank">nuScenes</a></dt>
            <dd>Large-scale autonomous driving dataset with full sensor suite (cameras, LiDAR, radar) and 3D bounding boxes.</dd>
            <dd class="meta">Motional | <a href="https://arxiv.org/abs/1903.11027" rel="nofollow noopener" target="_blank">Paper (CVPR 2020)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://waymo.com/open/" rel="nofollow noopener" target="_blank">Waymo Open Dataset</a></dt>
            <dd>High-quality sensor data from autonomous vehicles, including LiDAR, cameras, and 3D labels for perception tasks.</dd>
            <dd class="meta">Waymo | <a href="https://arxiv.org/abs/1912.04838" rel="nofollow noopener" target="_blank">Paper (CVPR 2020)</a></dd>
          </div>
        </dl>
      </section>

      <section id="3d-objects">
        <h2>3D Objects and Shapes</h2>
        
        <dl class="benchmark-list">
          <div class="benchmark-item">
            <dt><a href="https://shapenet.org/" rel="nofollow noopener" target="_blank">ShapeNet</a></dt>
            <dd>Large-scale repository of 3D CAD models organized by category, widely used for shape analysis and synthesis research.</dd>
            <dd class="meta">Stanford, Princeton, Toyota | <a href="https://arxiv.org/abs/1512.03012" rel="nofollow noopener" target="_blank">Paper (arxiv 2015)</a></dd>
          </div>

          <div class="benchmark-item">
            <dt><a href="https://objaverse.allenai.org/" rel="nofollow noopener" target="_blank">Objaverse</a></dt>
            <dd>Massive dataset of 800K+ annotated 3D objects for training and evaluating 3D vision models.</dd>
            <dd class="meta">Allen Institute for AI, University of Washington | <a href="https://arxiv.org/abs/2212.08051" rel="nofollow noopener" target="_blank">Paper (CVPR 2023)</a></dd>
          </div>
        </dl>
      </section>

      <section id="robotics">
        <h2>Robotics and Embodied AI</h2>
        
        <dl class="benchmark-list">
          <div class="benchmark-item">
            <dt><a href="https://robotics-transformer-x.github.io/" rel="nofollow noopener" target="_blank">Open X-Embodiment</a></dt>
            <dd>Large-scale dataset of robotic manipulation demonstrations across multiple robot platforms and tasks.</dd>
            <dd class="meta">Google DeepMind and collaborators | <a href="https://arxiv.org/abs/2310.08864" rel="nofollow noopener" target="_blank">Paper (CoRL 2023)</a></dd>
          </div>
        </dl>
      </section>

      <BetaCTA />
    </article>
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
