  "@type": "ItemList",
  "name": "Public Spatial AI Benchmarks",
  "description": "Major public benchmarks and datasets for 3D vision, spatial AI, autonomous driving, indoor scene understanding, and robotics.",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Dataset",
        "name": "ScanNet",
